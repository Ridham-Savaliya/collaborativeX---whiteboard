{
  "compilerOptions": {
    "target": "ES2020",
    "module": "es2022",
    "moduleResolution": "node",
    "rootDir": "../", // Go up to 'collaborativex' folder
    "outDir": "./dist",
    "baseUrl": "../",
    "paths": {
      "@models/*": [
        "models/*"
      ]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
  },
  "include": [
    "src"
  ]
}
